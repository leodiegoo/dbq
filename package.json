{
  "name": "@leodiegoo/dbq",
  "version": "0.1.0",
  "description": "Read-only query runner for SQL, MongoDB and Redis",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leodiegoo/dbq.git"
  },
  "bin": {
    "dbq": "./dist/cli.js"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "acorn": "^8.14.0",
    "commander": "^13.0.0",
    "mongodb": "^6.12.0",
    "mysql2": "^3.12.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "picocolors": "^1.1.1",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
